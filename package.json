{
  "name": "prompt-motion-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "make": "node scripts/make.mjs",
    "video": "node scripts/video.mjs",
    "render": "node scripts/render.mjs",
    "validate": "node scripts/validate.mjs",
    "clips": "node scripts/clips.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "check": "npm run validate && npm run typecheck && npm test"
  },
  "dependencies": {
    "@remotion/cli": "4.0.332",
    "remotion": "4.0.332",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
